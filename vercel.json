{
  "buildCommand": "bash scripts/build.sh",
  "outputDirectory": "public",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/api/reviews/",
      "destination": "/assets/avaliacoes-verificadas.json"
    },
    {
      "source": "/api/reviews",
      "destination": "/assets/avaliacoes-verificadas.json"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sitemap(.*).xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
